# ─── Firebase Configuration ────────────────────────────────────────────────
# Required for all environments. Get these from:
# Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ─── Sentry (error tracking) ───────────────────────────────────────────────
# Optional. Leave empty or comment out to disable Sentry.
# VITE_SENTRY_DSN=https://example@sentry.io/12345

# ─── Google Analytics 4 ────────────────────────────────────────────────────
# Optional. Get your Measurement ID from:
# Google Analytics → Admin → Data Streams → Web
# Leave empty or unset to disable GA tracking.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Firebase Emulators (Development Only) ─────────────────────────────────
# Set to "true" to connect to local Firebase emulators instead of production.
# Start emulators with: firebase emulators:start
# Or use: npm run dev:full
# VITE_USE_EMULATORS=true
# VITE_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost
# VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
# VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost
# VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# ─── Resend (Email) ──────────────────────────────────────────────────────
# Required for transactional email sending. Get your API key from:
# https://resend.com/api-keys
# Use a restricted API key with "email:send" scope for client-side usage.
# Leave empty to disable email sending (app works without it).
# VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxx
