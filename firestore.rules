rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // --- Auth basics ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- User document helpers (safe — check exists before accessing data) ---
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function safeGetUserRole() {
      let doc = getUserDoc();
      return doc.exists ? doc.data.role : null;
    }

    function safeGetUserBrokerId() {
      let doc = getUserDoc();
      return doc.exists ? doc.data.brokerId : null;
    }

    // --- Role checks ---
    function isBroker() {
      return isAuthenticated() && safeGetUserRole() == 'broker';
    }

    function isAgent() {
      return isAuthenticated() && safeGetUserRole() in ['agent', 'sub-agent'];
    }

    function isStaff() {
      return isAuthenticated() && safeGetUserRole() in ['agent', 'sub-agent', 'broker'];
    }

    // --- New role helpers (P27.8 RBAC enhancement) ---
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && safeGetUserRole() == 'admin';
    }

    function isBrokerOrAdmin() {
      return isAuthenticated() && safeGetUserRole() in ['broker', 'admin'];
    }

    function isSeniorAgent() {
      return isAuthenticated() && safeGetUserRole() == 'senior-agent';
    }

    function isComplianceOfficer() {
      return isAuthenticated() && safeGetUserRole() == 'compliance-officer';
    }

    function hasReadAllAccess() {
      return isAuthenticated() && safeGetUserRole() in ['broker', 'senior-agent', 'compliance-officer', 'admin'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Broker-org isolation ---
    // Does the authenticated user share the same brokerId as another user?
    function isSameBrokerOrg(userId) {
      let target = get(/databases/$(database)/documents/users/$(userId));
      return isAuthenticated() && target.exists && safeGetUserBrokerId() == target.data.brokerId;
    }

    // Generic check: does the resource's brokerId match the current user's org?
    function inMyOrg(resource) {
      return isAuthenticated() && resource.data.brokerId == safeGetUserBrokerId();
    }

    // --- Assignment / ownership checks ---
    function isAssignedOrBroker(resource) {
      return isBroker() || (isAgent() && resource.data.assignedTo == request.auth.uid);
    }

    function isCreatorOrBroker(resource) {
      return isBroker() || (isAgent() && resource.data.createdBy == request.auth.uid);
    }

    function isCreatorOrBrokerUsingRequest() {
      return isBroker() || (isAgent() && request.resource.data.createdBy == request.auth.uid);
    }

    // --- Field validation ---
    function requireFields(fields) {
      return fields.all(field, request.resource.data.keys().hasAll([field]));
    }

    function requireFieldWriteOnce() {
      // Prevents overwriting a field after creation (set it once, then immutable)
      return true; // stub — override per-collection if needed
    }

    // --- Immutability / deletion guards ---
    function denyAll() {
      return false;
    }

    // =========================================================================
    // COLLECTIONS
    // =========================================================================

    // -----------------------------------------------------------------------
    // USERS
    //   read:    self, same broker org, or compliance-officer/senior-agent
    //   create:  self only (sign-up flow)
    //   update:  self or broker
    //   delete:  NEVER — deactivate instead
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isSameBrokerOrg(userId)) || hasReadAllAccess();
      allow create: if isOwner(userId) && requireFields(['email', 'role', 'name', 'brokerId']);
      allow update: if isOwner(userId) || isBroker();
      allow delete: if false;

      // ─── User Sessions (subcollection) ──────────────────────────
      //   create:  self only
      //   read:    self, broker, or compliance-officer/senior-agent
      //   update:  self only (heartbeat / end session) or broker (revoke)
      //   delete:  NEVER (only revoke via update)
      // ─────────────────────────────────────────────────────────────
      match /sessions/{sessionId} {
        allow create: if isOwner(userId);
        allow read:   if isOwner(userId) || isBrokerOrAdmin();
        allow update: if isOwner(userId) || isBrokerOrAdmin();
        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // OFFICES
    //   read:    agents/brokers in the owning org, compliance-officer, senior-agent
    //   create:  broker only
    //   update:  broker only (same org)
    //   delete:  broker only (same org)
    // -----------------------------------------------------------------------
    match /offices/{officeId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'address', 'phone', 'brokerId']);
      allow update: if isBroker() && inMyOrg(resource);
      allow delete: if isBroker() && inMyOrg(resource);
    }

    // -----------------------------------------------------------------------
    // LEADS
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or assigned agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['name', 'contact', 'brokerId']);
      allow update: if isBroker() || resource.data.assignedTo == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // LISTINGS
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or assigned agent
    //   delete:  broker only
    //
    //   listingMedia (subcollection): agent uploads own, broker manages all
    // -----------------------------------------------------------------------
    match /listings/{listingId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['title', 'price', 'status', 'brokerId']);
      allow update: if isBroker() || resource.data.assignedTo == request.auth.uid;
      allow delete: if isBroker();

      // Listing Media subcollection
      match /listingMedia/{mediaId} {
        allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
        allow create: if isAuthenticated() && requireFields(['url', 'type', 'uploadedBy', 'brokerId']);
        allow update: if isBroker() || resource.data.uploadedBy == request.auth.uid;
        allow delete: if isBroker() || resource.data.uploadedBy == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------------
    // DEALS
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or creator
    //   delete:  NEVER (critical financial data)
    // -----------------------------------------------------------------------
    match /deals/{dealId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['title', 'status', 'brokerId', 'createdBy']);
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // PAYMENTS  (per-deal payment/collection tracker)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or creator
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['dealId', 'type', 'amount', 'dueDate', 'brokerId']);
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // COMMISSION PLANS
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /commissionPlans/{planId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'type', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // PAYOUTS
    //   read:    broker, same org, self (agentId), or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker only
    //   delete:  NEVER (financial record)
    // -----------------------------------------------------------------------
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['amount', 'agentId', 'brokerId']);
      allow update: if isBroker();
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // VIEWINGS
    //   read:    broker, same org, assigned agent, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or assigned agent
    //   delete:  NEVER (client-relationship record)
    // -----------------------------------------------------------------------
    match /viewings/{viewingId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['listingId', 'date', 'clientName', 'brokerId']);
      allow update: if isBroker() || resource.data.agentId == request.auth.uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // TASKS
    //   read:    broker, same org, assigned agent, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or assigned agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.assignedTo == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['title', 'assignedTo', 'brokerId']);
      allow update: if isBroker() || resource.data.assignedTo == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // CALL LOGS  (per-lead/per-deal call tracking)
    //   read:    broker, same org, owning agent, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or owning agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /callLogs/{logId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.createdBy == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['contactName', 'duration', 'brokerId']);
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // EXPENSES
    //   read:    broker, same org, self (agentId), or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or owning agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['amount', 'category', 'brokerId']);
      allow update: if isBroker() || resource.data.agentId == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // NOTIFICATIONS
    //   read:    self (userId matches), broker, or compliance-officer/senior-agent
    //   create:  any staff (system-generated)
    //   update:  self only
    //   delete:  NEVER
    // -----------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isBroker()) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // AUDIT LOGS  — append-only immutable log
    //   read:    broker or compliance-officer
    //   create:  any staff
    //   update:  NEVER
    //   delete:  NEVER
    // -----------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isBroker() || isComplianceOfficer();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // REFERRALS
    //   read:    broker, same org, assigned agent, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or assigned agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['referralName', 'status', 'brokerId']);
      allow update: if isBroker() || resource.data.agentId == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // MORTGAGES  (linked to deals)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or creator
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /mortgages/{mortgageId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['dealId', 'lender', 'amount', 'status', 'brokerId']);
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // COMM TEMPLATES  (communication templates)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /commTemplates/{templateId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'subject', 'body', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // DOCUMENTS  (document vault — per-deal/per-listing)
    //   read:    broker, same org, uploader, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or uploader
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.uploadedBy == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['name', 'url', 'dealId', 'brokerId', 'uploadedBy']);
      allow update: if isBroker() || resource.data.uploadedBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // CHECKLIST TEMPLATES
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /checklistTemplates/{templateId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'items', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // CHECKLIST INSTANCES  (linked to deals / leads)
    //   read:    broker, same org, assigned agent, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or assigned agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /checklistInstances/{instanceId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.assignedTo == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['templateId', 'assignedTo', 'linkedTo', 'linkedType', 'brokerId']);
      allow update: if isBroker() || resource.data.assignedTo == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // ACTIVITY LOGS  — append-only immutable timeline
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff (append)
    //   update:  NEVER
    //   delete:  NEVER
    // -----------------------------------------------------------------------
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // PROJECTS  (subdivision / condo developments)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'developer', 'totalUnits', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // LICENSES  (license expiry tracker)
    //   read:    broker, same org, self (agentId), or compliance-officer/senior-agent
    //   create:  broker only (manages team licenses)
    //   update:  broker or owning agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /licenses/{licenseId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isBroker();
      allow update: if isBroker() || resource.data.agentId == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // TOURS  (property tour itineraries)
    //   read:    broker, same org, owning agent, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or owning agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /tours/{tourId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['title', 'clientName', 'scheduledDate', 'agentId']);
      allow update: if isBroker() || resource.data.agentId == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // LEAD ACTIVITY (subcollection under each lead) — append-only timeline
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff (append)
    //   update:  NEVER
    //   delete:  NEVER
    // -----------------------------------------------------------------------
    match /leads/{leadId}/leadActivity/{activityId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // PROJECTS  (subdivision / condo development management)
    //   read:    authenticated user or compliance-officer/senior-agent
    //   create:  broker only (developer manages own projects)
    //   update:  broker or assigned agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAuthenticated() || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'developer', 'totalUnits', 'location']);
      allow update: if isBroker() || (isAgent() && resource.data.assignedTo.hasAny([request.auth.uid]));
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // UNITS  (individual lots/units within projects)
    //   read:    authenticated user or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker or agent assigned to the project
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /units/{unitId} {
      allow read: if isAuthenticated() || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['projectId', 'block', 'lot', 'area', 'price']);
      allow update: if isBroker() || isAgent();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // PAYMENT MILESTONES  (payment schedules for units)
    //   read:    authenticated user or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker or agent
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /paymentMilestones/{milestoneId} {
      allow read: if isAuthenticated() || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['projectId', 'unitId', 'name', 'amount', 'dueDate']);
      allow update: if isBroker() || isAgent();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // AGENT GOALS  (sales targets per agent)
    //   read:    broker, same org, self, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /goals/{goalId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.agentId == request.auth.uid) || hasReadAllAccess();
      allow create: if isBroker();
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // CO-BROKERS  (external broker directory)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /coBrokers/{coBrokerId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'brokerage', 'phone', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // CO-BROKER DEALS  (cross-brokerage deal splits)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /coBrokerDeals/{dealId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['dealId', 'coBrokerId', 'splitPercentage']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // TEAMS  (agent teams)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'teamLeadId', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // BRANCHES  (office/branch locations)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /branches/{branchId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isBroker() && requireFields(['name', 'address', 'city', 'province', 'brokerId']);
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // PROPERTY DOCUMENTS  (per-property document vault)
    //   read:    broker, same org, uploader, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or uploader
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /propertyDocuments/{docId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource) || resource.data.uploadedBy == request.auth.uid) || hasReadAllAccess();
      allow create: if isAuthenticated() && requireFields(['name', 'fileUrl', 'category', 'brokerId']);
      allow update: if isBroker() || resource.data.uploadedBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // COMPLIANCE CHECKLISTS  (deal closing compliance)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /complianceChecklists/{checklistId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // CMA REPORTS  (comparative market analysis)
    //   read:    broker, same org, or compliance-officer/senior-agent
    //   create:  any staff
    //   update:  broker or creator
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /cmaReports/{reportId} {
      allow read: if isAuthenticated() && (isBroker() || inMyOrg(resource)) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // vaultDocuments — document vault per property
    //   read:   authenticated + in org, or compliance-officer/senior-agent
    //   create: authenticated
    //   update: broker or creator
    //   delete: broker only
    // -----------------------------------------------------------------------
    match /vaultDocuments/{docId} {
      allow read: if isAuthenticated() && inMyOrg(resource) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // vaultDocumentVersions — version history of vault documents
    //   read:   authenticated + in org, or compliance-officer/senior-agent
    //   create: authenticated
    //   update: broker or creator
    //   delete: broker only
    // -----------------------------------------------------------------------
    match /vaultDocumentVersions/{docId} {
      allow read: if isAuthenticated() && inMyOrg(resource) || hasReadAllAccess();
      allow create: if isAuthenticated();
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // invitations — agent/broker invites
    //   read:   broker or compliance-officer/senior-agent
    //   create: broker only
    //   update: broker only
    //   delete: broker only
    // -----------------------------------------------------------------------
    match /invitations/{inviteId} {
      allow read: if isBroker() || hasReadAllAccess();
      allow create: if isBroker();
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // EMAIL LOGS  — append-only audit trail for sent emails
    //   create:  any authenticated user (logged by email service)
    //   read:    self (userId matches) or broker/admin
    //   update:  NEVER (immutable log)
    //   delete:  NEVER (immutable log)
    // -----------------------------------------------------------------------
    match /emailLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isBrokerOrAdmin());
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // EMAIL PREFERENCES  — per-user notification settings
    //   read:    self only
    //   create:  self only
    //   update:  self only
    //   delete:  NEVER (user clears toggles instead)
    // -----------------------------------------------------------------------
    match /emailPreferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // SCHEDULED REPORTS  — per-user recurring report schedules
    //   read:    self (userId matches)
    //   create:  self (userId in doc matches)
    //   update:  self
    //   delete:  self
    // -----------------------------------------------------------------------
    match /scheduledReports/{reportId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // -----------------------------------------------------------------------
    // MESSAGE LOGS  — messaging history for WhatsApp/Viber/SMS
    //   create:  any authenticated user
    //   read:    same broker org, or broker/admin/compliance-officer
    //   update:  NEVER (immutable log)
    //   delete:  NEVER (immutable log)
    // -----------------------------------------------------------------------
    match /messageLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (inMyOrg(resource) || isBrokerOrAdmin() || isComplianceOfficer());
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // MESSAGE TEMPLATES  — per-broker message templates
    //   read:    same broker org
    //   create:  broker only
    //   update:  broker or creator
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /messageTemplates/{templateId} {
      allow read: if request.auth != null && (inMyOrg(resource) || hasReadAllAccess());
      allow create: if isBroker();
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // PAYMENT TRANSACTIONS  — online payment gateway records
    //   create:  any authenticated user
    //   read:    same broker org
    //   update:  broker or creator (for status updates from webhook)
    //   delete:  NEVER (financial record immutability)
    // -----------------------------------------------------------------------
    match /paymentTransactions/{txnId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (inMyOrg(resource) || hasReadAllAccess());
      allow update: if isBroker() || resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // PAYMENT GATEWAY CONFIG  — per-broker PayMongo settings
    //   read:    broker self
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /paymentGatewayConfig/{configId} {
      allow read: if isBrokerOrAdmin();
      allow create: if isBroker();
      allow update: if isBroker();
      allow delete: if isBroker();
    }

    // -----------------------------------------------------------------------
    // FACEBOOK IMPORT LOGS  — append-only audit trail for Facebook lead imports
    //   create:  any authenticated user
    //   read:    same broker org, or broker/admin/compliance-officer
    //   update:  NEVER (immutable log)
    //   delete:  NEVER (immutable log)
    // -----------------------------------------------------------------------
    match /facebookImportLogs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (inMyOrg(resource) || isBrokerOrAdmin() || isComplianceOfficer());
      allow update: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // FACEBOOK SETTINGS  — per-broker Facebook integration config
    //   read:    same broker org
    //   create:  broker only
    //   update:  broker only
    //   delete:  broker only
    // -----------------------------------------------------------------------
    match /facebookSettings/{settingsId} {
      allow read: if request.auth != null && (inMyOrg(resource) || isBrokerOrAdmin());
      allow create: if isBroker();
      allow update: if isBroker();
      allow delete: if isBroker();
    }

  }
}
